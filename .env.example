# Contraseña del único usuario administrador (obligatoria en producción)
ADMIN_PASSWORD=cambiame-por-una-contrasena-larga
# Clave para firmar la sesión del panel (opcional; si falta se deriva de la contraseña)
ADMIN_SECRET=
# Carpeta donde vive la base SQLite (en Coolify: volumen persistente montado en /app/data)
DATA_DIR=./data
